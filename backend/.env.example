# Copie para backend/.env e ajuste. Nunca suba o .env para o GitHub.

# ── Desenvolvimento local (Mosquitto do docker compose / start.sh) ──
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TLS=false

# ── Broker na nuvem (ex.: EMQX Serverless) ──
# MQTT_BROKER_HOST=xxxxxxxx.ala.us-east-1.emqxsl.com
# MQTT_BROKER_PORT=8883
# MQTT_TLS=true
# MQTT_USERNAME=seu_usuario_mqtt
# MQTT_PASSWORD=sua_senha_mqtt
# Opcional, se o broker exigir o certificado da CA dele:
# MQTT_CA_CERT_PATH=/caminho/para/emqxsl-ca.crt

MQTT_CLIENT_ID=blackjack_backend
LOG_LEVEL=INFO
